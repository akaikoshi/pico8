pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
// ----------------------------
// p8 ansi picture viewer
// 
// by #592c63/akaikoshi - 2026
//
// use arrow keys to manage 
// scrolling if picture
// height is > 24
//
// enjoy !
// ---------------------------
cls(0) 
m=0f=0s=1
h=120 // image height
function _draw()
 for i=0,639do
  x=4*(i%32)
  y=6*(i\32)+2
  a=((f%h)*64+2*i)%(64*h)
  c=peek(a)
  k=peek(a+1)
  color(k&15)rectfill(x,y,x+3,y+5)
  color((k\16)&15)cursor(x,y)
  if c>111then c=56+c\2end
  ?chr(c+16)
 end
 if h>24 then
  b=btn()
  if m==0then f=f+s end
  if b==1then m=1f=(f+h-1)%h end
  if b==2then m=1f=(f+1)%h end
  if b==4then m=0s=h-1end
  if b==8then m=0s=1end
 end
end
